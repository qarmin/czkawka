            }

            CheckBoxWrapper {
                text: Translations.subsettings_bad_names_non_ascii_text;
                checked <=> Settings.bad_names_sub_non_ascii;
            }

            HintText {
                width: root.hint_width;
                hint_text: Translations.subsettings_bad_names_non_ascii_hint_text;
            }

            CheckBoxWrapper {
                text: Translations.subsettings_bad_names_restricted_charset_text;
                checked <=> Settings.bad_names_sub_restricted_charset_enabled;
            }

            HintText {
                width: root.hint_width;
                hint_text: Translations.subsettings_bad_names_restricted_charset_hint_text;
            }

            if Settings.bad_names_sub_restricted_charset_enabled: HorizontalLayout {
                spacing: 5px;
                Text {
                    text: Translations.subsettings_bad_names_allowed_chars_text;
                    vertical-alignment: center;
                }
                LineEdit {
                    text <=> Settings.bad_names_sub_restricted_charset;
                    placeholder-text: "_- ";
                }
            }

            CheckBoxWrapper {
                text: Translations.subsettings_bad_names_remove_duplicated_text;
                checked <=> Settings.bad_names_sub_remove_duplicated;
            }

            HintText {
                width: root.hint_width;
                hint_text: Translations.subsettings_bad_names_remove_duplicated_hint_text;
            }

            Rectangle { }
        }

        if GuiState.active_tab == ActiveTab.VideoOptimizer: VerticalLayout {
            spacing: 5px;
            padding: 10px;
            ComboBoxWrapper {
                text: Translations.subsettings_video_optimizer_mode_text;
                model: Settings.video_optimizer_sub_mode;
                current_index <=> Settings.video_optimizer_sub_mode_index;
                current_value <=> Settings.video_optimizer_sub_mode_value;
            }

            if Settings.video_optimizer_sub_mode_index == 1: VerticalLayout {
                spacing: 5px;

                HorizontalLayout {
                    spacing: 5px;
                    Text {
                        text: Translations.subsettings_video_optimizer_excluded_codecs_text;
                        vertical_alignment: TextVerticalAlignment.center;
                        font-size: FontSizes.normal;
                    }

                    LineEdit {
                        text <=> Settings.video_optimizer_sub_excluded_codecs;
                        font-size: FontSizes.normal;
                    }

                    Button {
                        text: Translations.subsettings_reset_text;
                        clicked => {
                            Settings.video_optimizer_sub_excluded_codecs = "h265,av1,vp9";
                        }
                    }
                }

            }

            if Settings.video_optimizer_sub_mode_index == 0: VerticalLayout {
                spacing: 5px;

                ComboBoxWrapper {
                    text: Translations.subsettings_video_optimizer_crop_type_text;
                    model: Settings.video_optimizer_sub_crop_type;
                    current_index <=> Settings.video_optimizer_sub_crop_type_index;
                    current_value <=> Settings.video_optimizer_sub_crop_type_value;
                }

                HorizontalLayout {
                    spacing: 5px;
                    Text {
                        text: Translations.subsettings_video_optimizer_black_pixel_threshold_text;
                        vertical_alignment: TextVerticalAlignment.center;
                        font-size: FontSizes.normal;
                    }

                    LineEdit {
                        text <=> Settings.video_optimizer_sub_black_pixel_threshold;
                        font-size: FontSizes.normal;
                    }

                    Button {
                        text: Translations.subsettings_reset_text;
                        clicked => {
                            Settings.video_optimizer_sub_black_pixel_threshold = "20";
                        }
                    }
                }

                HintText {
                    width: root.hint_width;
                    hint_text: Translations.subsettings_video_optimizer_black_pixel_threshold_hint_text;
                }

                HorizontalLayout {
                    spacing: 5px;
                    Text {
                        text: Translations.subsettings_video_optimizer_black_bar_min_percentage_text;
                        vertical_alignment: TextVerticalAlignment.center;
                        font-size: FontSizes.normal;
                    }

                    LineEdit {
                        text <=> Settings.video_optimizer_sub_black_bar_min_percentage;
                        font-size: FontSizes.normal;
                    }

                Button {
                    text: Translations.subsettings_reset_text;
                    clicked => {
                        Settings.video_optimizer_sub_black_bar_min_percentage = "90";
                    }
                }
                }

                HintText {
                    width: root.hint_width;
                    hint_text: Translations.subsettings_video_optimizer_black_bar_min_percentage_hint_text;
                }

                HorizontalLayout {
                    spacing: 5px;
                    Text {
                        text: Translations.subsettings_video_optimizer_max_samples_text;
                        vertical_alignment: TextVerticalAlignment.center;
                        font-size: FontSizes.normal;
                    }

                    LineEdit {
                        text <=> Settings.video_optimizer_sub_max_samples;
                        font-size: FontSizes.normal;
                    }

                    Button {
                        text: Translations.subsettings_reset_text;
                        clicked => {
                            Settings.video_optimizer_sub_max_samples = "60";
                        }
                    }
                }

                HintText {
                    width: root.hint_width;
                    hint_text: Translations.subsettings_video_optimizer_max_samples_hint_text;
                }

                HorizontalLayout {
                    spacing: 5px;
                    Text {
                        text: Translations.subsettings_video_optimizer_min_crop_size_text;
                        vertical_alignment: TextVerticalAlignment.center;
                        font-size: FontSizes.normal;
                    }

                    LineEdit {
                        text <=> Settings.video_optimizer_sub_min_crop_size;
                        font-size: FontSizes.normal;
                    }

                    Button {
                        text: Translations.subsettings_reset_text;
                        clicked => {
                            Settings.video_optimizer_sub_min_crop_size = "20";
                        }
                    }
                }

                HintText {
                    width: root.hint_width;
                    hint_text: Translations.subsettings_video_optimizer_min_crop_size_hint_text;
                }
            }

            Rectangle { }
        }

        if GuiState.active_tab == ActiveTab.ExifRemover: VerticalLayout {
            spacing: 5px;
            padding: 10px;
            HorizontalLayout {
                spacing: 5px;
                Text {
                    text: Translations.subsettings_exif_ignored_tags_text;
                    vertical_alignment: TextVerticalAlignment.center;
                    font-size: FontSizes.normal;
                }

                LineEdit {
                    text <=> Settings.ignored_exif_tags;
                    font-size: FontSizes.normal;
                }
            }

            HintText {
                width: root.hint_width;
                hint_text: Translations.subsettings_exif_ignored_tags_hint_text;
            }

            Rectangle { }
        }

        if GuiState.active_tab == ActiveTab.FolderCompare: VerticalLayout {
            spacing: 5px;
            padding: 10px;

            HintText {
                width: root.hint_width;
                hint_text: Translations.folder_compare_mode_hint_text;
            }

            CheckBoxWrapper {
                text: Translations.folder_compare_ignore_names_text;
                checked <=> GuiState.folder_compare_ignore_names;
            }

            HintText {
                width: root.hint_width;
                hint_text: Translations.folder_compare_ignore_names_hint_text;
            }

            CheckBoxWrapper {
                text: Translations.folder_compare_find_subsets_text;
                checked <=> GuiState.folder_compare_find_subsets;
            }

            HintText {
                width: root.hint_width;
                hint_text: Translations.folder_compare_find_subsets_hint_text;
            }

            ComboBoxWrapper {
                text: Translations.folder_compare_min_files_text;
                model: ["1", "2", "3", "5", "10", "50"];
                current_index <=> GuiState.folder_compare_min_files_index;
            }

            Rectangle { }
        }

        if GuiState.active_tab == ActiveTab.DiskUsage: VerticalLayout {
            spacing: 5px;
            padding: 10px;

            CheckBoxWrapper {
                text: Translations.disk_usage_ignore_excluded_items_text;
                checked <=> DiskUsageState.ignore_excluded_items;
            }

            CheckBoxWrapper {
                text: Translations.disk_usage_ignore_excluded_directories_text;
                checked <=> DiskUsageState.ignore_excluded_directories;
            }

            HintText {
                width: root.hint_width;
                hint_text: Translations.disk_usage_ignore_excluded_hint_text;
            }

            Rectangle {
                height: 6px;
            }

            ComboBoxWrapper {
                text: Translations.disk_usage_content_detection_text;
                model: [
                    Translations.disk_usage_content_detection_extension_text,
                    Translations.disk_usage_content_detection_large_text,
                    Translations.disk_usage_content_detection_all_text,
                ];
                current_index <=> DiskUsageState.content_detection_index;
            }

            HintText {
                width: root.hint_width;
                hint_text: Translations.disk_usage_content_detection_hint_text;
            }

            Rectangle {
                height: 6px;
            }

            OptionsGroupHeader {
                title: Translations.disk_usage_detail_title_text;
                hint: Translations.disk_usage_detail_hint_text;
                hint_width: root.hint_width;
            }

            SliderWrapper {
                text: Translations.disk_usage_group_below_text;
                end_text: "1/" + round(pow(10, round(DiskUsageState.group_exponent)));
                max_end_text: "1/10000000";
                minimum: 2;
                maximum: 7;
                value <=> DiskUsageState.group_exponent;
                value_changed => {
                    DiskUsageState.options_changed();
                }
            }

            SliderWrapper {
                text: Translations.disk_usage_min_item_text;
                end_text: round(DiskUsageState.min_item_px) + " px";
                max_end_text: "10 px";
                minimum: 1;
                maximum: 10;
                value <=> DiskUsageState.min_item_px;
                value_changed => {
                    DiskUsageState.options_changed();
                }
            }

            SliderWrapper {
                text: Translations.disk_usage_folder_block_text;
                end_text: round(DiskUsageState.folder_block_px) == 0 ? "-" : round(DiskUsageState.folder_block_px) + " px";
                max_end_text: "60 px";
                minimum: 0;
                maximum: 60;
                value <=> DiskUsageState.folder_block_px;
                value_changed => {
                    DiskUsageState.options_changed();
                }
            }

            Rectangle { }
        }
    }
}
