import { Button, CheckBox, ComboBox, LineEdit, ScrollView, Slider } from "std-widgets.slint";
import { ActiveTab } from "../globals/common.slint";
import { DiskUsageState } from "../globals/disk_usage_state.slint";
import { Settings } from "../globals/settings.slint";
import { GuiState } from "../globals/gui_state.slint";
import { TextComponent } from "settings_list.slint";
import { Translations } from "../globals/translations.slint";
import { FontSizes } from "../globals/fonts.slint";
import { Callabler } from "../globals/callabler.slint";
import { HintText } from "../components/hint_text.slint";

component ComboBoxWrapper inherits HorizontalLayout {
    in-out property <string> text;
    in-out property <[string]> model;
    in-out property <int> current_index;
    in-out property <string> current_value: root.model[root.current_index];
    spacing: 5px;
    vertical-stretch: 0;
    Text {
        text <=> root.text;
        vertical_alignment: TextVerticalAlignment.center;
        font-size: FontSizes.normal;
    }

    ComboBox {
        model: root.model;
        current_index <=> root.current_index;
        current_value <=> root.current_value;
    }
}

component CheckBoxWrapper inherits CheckBox {
    vertical-stretch: 0;
}

component OptionsGroupHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    in property <length> hint_width;
    spacing: 2px;
    Text {
        text: root.title;
        font-size: FontSizes.normal;
        font-weight: FontSizes.bold_light;
        height: 25px;
        vertical-alignment: TextVerticalAlignment.center;
    }

    HintText {
        width: root.hint_width;
        hint_text: root.hint;
    }
}

// Reusable text wrapper to centralize font-size and height
component LabelText inherits Text {
    in-out property <string> label_text;
    in-out property <length> label_font_size: FontSizes.normal;
    in-out property <length> label_height: 25px;
    text: root.label_text;
    font-size: root.label_font_size;
    height: root.label_height;
    vertical-alignment: TextVerticalAlignment.center;
}

component SliderWrapper inherits HorizontalLayout {
    in-out property <float> maximum;
    in-out property <float> minimum: 0;
    in-out property <float> value;
    in-out property <string> text;
    in-out property <string> end_text;
    in-out property <string> max_end_text;
    callback value_changed();
    spacing: 5px;
    vertical-stretch: 0;
    Text {
        text: root.text;
        font-size: FontSizes.normal;
        vertical-alignment: center;
    }

    Slider {
        min-width: 30px;
        minimum <=> root.minimum;
        maximum <=> root.maximum;
        value <=> root.value;
        changed(value) => {
            root.value_changed();
        }
    }

    Rectangle {
        width: end_text_sizer.preferred-width;
        end_text_sizer := Text {
            text: root.max_end_text;
            font-size: FontSizes.normal;
            visible: false;
        }
        Text {
            text: root.end_text;
            font-size: FontSizes.normal;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 100%;
            height: 100%;
        }
    }
}

export component ToolSettings inherits ScrollView {
    in property <length> limit_height: 400px;
    // Wrapped text is measured at its current width, so hints need an explicit one for the popup height to be right
    private property <length> hint_width: root.width - 36px;

