import { Button } from "std-widgets.slint";
import { PopupBackdrop } from "popup_backdrop.slint";
import { ColorPalette } from "../globals/color_palette.slint";
import { Translations } from "../globals/translations.slint";
import { FontSizes } from "../globals/fonts.slint";

export component PopupBase inherits PopupWindow {
    in-out property <string> title_text: "TODO - needs to be changed";
    in-out property <string> ok_text <=> Translations.ok_button_text;
    in-out property <string> cancel_text <=> Translations.cancel_button_text;
    in-out property <bool> enabled_ok_button: true;
    in-out property <bool> show_cancel_button: true;
    in property <length> popup_min_height: 0px;

    callback ok_clicked();
    callback cancel_clicked();

    height: max(popup_min_height, vlayout.preferred-height);
    close-policy: PopupClosePolicy.no-auto-close;
    PopupBackdrop { }

    rect := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 10px;
        border-color: ColorPalette.popup_border_color;
        border-width: 2px;
        background: ColorPalette.popup_background;
        vlayout := VerticalLayout {
            padding: 2px;
            Rectangle {
                background: ColorPalette.popup_background_title_line;
                border-top-left-radius: 8px;
                border-top-right-radius: 8px;

                Text {
                    vertical-stretch: 0.0;
                    min-height: 30px;
                    text <=> title_text;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    font-size: FontSizes.normal;
                }
            }

            @children

            Rectangle {
                background: ColorPalette.popup_background_footer;
                border-bottom-left-radius: 8px;
                border-bottom-right-radius: 8px;

                HorizontalLayout {
                    padding: 10px;
                    Button {
                        enabled <=> enabled_ok_button;
                        text <=> ok_text;
                        primary: true;
                        clicked => {
                            root.close();
                            ok_clicked();
                        }
                    }

                    Rectangle { }

                    if show_cancel_button: Button {
                        text <=> cancel_text;
                        clicked => {
                            root.close();
                        }
                    }
                }
            }
        }
    }
}
